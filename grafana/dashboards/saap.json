{
  "uid": "saap-main",
  "title": "SAAP — Produção em tempo real",
  "tags": ["saap", "producao"],
  "style": "dark",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "refresh": "1s",
  "time": { "from": "now-12h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    { "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "🏭 Produção", "tooltip": "", "type": "link", "url": "/d/saap-producao/saap-producao" },
    { "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "🔧 Diagnóstico", "tooltip": "", "type": "link", "url": "/d/saap-diagnostico/saap-diagnostico" },
    { "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "📈 Histórico / Gestão", "tooltip": "", "type": "link", "url": "/d/saap-historico/saap-historico" },
    { "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": false, "title": "🖥️ Sistema", "tooltip": "", "type": "link", "url": "/d/saap-sistema/saap-sistema" }
  ],
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "# FlowCount\n##### Sala de controle da produção — contagem automática por estação"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Peças no período — linha toda",
      "description": "Soma de todas as passagens válidas registradas no intervalo selecionado, com a tendência por janelas de 15 minutos.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ocorrido_em, '15m') AS time, sum(delta) AS value\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "peças",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Bancadas sem comunicação",
      "description": "Quantas estações não mandam nenhum evento há mais de 5 minutos, em qualquer período do histórico (RF05 / RF04). 0 = todas reportando normalmente.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT count(*) AS silenciosas\nFROM (\n  SELECT bancada, max(recebido_em) AS ultima\n  FROM producao\n  GROUP BY bancada\n) t\nWHERE ultima < now() - interval '5 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#d03b3b", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Peças por bancada — meta do período",
      "description": "Vermelho = abaixo de 40 peças; laranja = entre 40 e 80; verde = 80 ou mais. Ajuste os degraus em Field > Thresholds conforme a meta real (RF10).",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT bancada, sum(delta) AS total\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY bancada\nORDER BY bancada"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "peças",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 40 },
              { "color": "#0ca30c", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "text": { "valueSize": 14 }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peças por hora (ritmo da linha)",
      "description": "Uma cor fixa por bancada — B01 azul, B02 laranja, B03 verde-água — a mesma cor em todos os painéis do dashboard.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ocorrido_em, '1h') AS time, bancada, sum(delta) AS value\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY 1, bancada\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "peças",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "B01" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "B02" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
          { "matcher": { "id": "byName", "options": "B03" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "B04" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Peças por turno",
      "description": "Turno definido pelo horário real do evento (06h-14h / 14h-22h / 22h-06h, horário de Brasília) — ver a função turno_do_horario() em postgres/init/002_turno.sql. Não depende de nenhum contador enviado pelo nó, funciona com hardware real.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT turno_do_horario(ocorrido_em) AS turno, bancada, sum(delta) AS total\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY turno, bancada\nORDER BY turno, bancada"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "total" }, "properties": [ { "id": "unit", "value": "peças" } ] },
          { "matcher": { "id": "byName", "options": "bancada" }, "properties": [ { "id": "displayName", "value": "estação" } ] }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Peças por minuto (últimos eventos) — detecção visual de micro-parada",
      "description": "Mesma paleta fixa por bancada da visão por hora. Uma linha caindo a zero por vários minutos indica micro-parada (RF09).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ocorrido_em, '1m') AS time, bancada, sum(delta) AS value\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY 1, bancada\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "peças",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "B01" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "B02" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } } ] },
          { "matcher": { "id": "byName", "options": "B03" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "B04" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Horário da última comunicação por bancada (RF04 / CS06)",
      "description": "Sempre olha o histórico inteiro, não só o período selecionado no canto superior direito. Fundo colorido pelo tempo desde a última mensagem: verde até 1 min, laranja até 5 min, vermelho acima disso.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT bancada, max(recebido_em) AS ultima_comunicacao,\n       EXTRACT(EPOCH FROM (now() - max(recebido_em))) AS segundos_desde\nFROM producao\nGROUP BY bancada\nORDER BY bancada"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "bancada" },
            "properties": [ { "id": "displayName", "value": "estação" } ]
          },
          {
            "matcher": { "id": "byName", "options": "ultima_comunicacao" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" },
              { "id": "displayName", "value": "última comunicação" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "segundos_desde" },
            "properties": [
              { "id": "displayName", "value": "status" },
              { "id": "unit", "value": "s" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 60 },
                    { "color": "#d03b3b", "value": 300 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
