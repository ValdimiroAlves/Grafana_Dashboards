{
  "uid": "saap-main",
  "title": "SAAP — Produção em tempo real",
  "tags": ["saap", "producao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-12h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Peças no período — linha toda",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT sum(delta) AS total\nFROM producao\nWHERE $__timeFilter(ocorrido_em)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Peças por bancada — período",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT bancada, sum(delta) AS total\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY bancada\nORDER BY bancada"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 40 }, { "color": "green", "value": 80 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Peças por hora (ritmo da linha)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ocorrido_em, '1h') AS time, bancada, sum(delta) AS value\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY 1, bancada\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Total do turno por bancada",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (bancada) bancada, total_turno, ocorrido_em AS ultimo_evento_com_total\nFROM producao\nWHERE $__timeFilter(ocorrido_em) AND total_turno IS NOT NULL\nORDER BY bancada, ocorrido_em DESC"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Peças por minuto (últimos eventos) — detecção visual de micro-parada",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ocorrido_em, '1m') AS time, bancada, sum(delta) AS value\nFROM producao\nWHERE $__timeFilter(ocorrido_em)\nGROUP BY 1, bancada\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Horário da última comunicação por bancada (RF04 / CS06)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "table",
          "rawSql": "SELECT bancada, max(recebido_em) AS ultima_comunicacao\nFROM producao\nGROUP BY bancada\nORDER BY bancada"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ultima_comunicacao" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" },
              { "id": "displayName", "value": "última comunicação" }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
