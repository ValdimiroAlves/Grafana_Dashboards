      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "mode": "markdown",
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "# 🖥️ Sistema\n##### Saúde do servidor (Raspberry Pi) e do broker MQTT — equipe técnica"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Temperatura da CPU",
      "description": "Lida de /sys/class/thermal na Raspberry real (requer pid: host no docker-compose.yml).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 3 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT capturado_em AS time, temperatura_c AS value\nFROM sistema_metricas\nWHERE $__timeFilter(capturado_em)\nORDER BY capturado_em"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#0ca30c", "value": null }, { "color": "#fab219", "value": 60 }, { "color": "#d03b3b", "value": 75 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Carga de CPU (1 min)",
      "description": "os.loadavg()[0]. Numa Pi 5 (4 núcleos), acima de 4 significa mais trabalho do que núcleos disponíveis.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 3 },
      "datasource": { "type": "postgres", "uid": "saap-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "saap-postgres" },
          "format": "time_series",
          "rawSql": "SELECT capturado_em AS time, carga_cpu_1min AS value\nFROM sistema_metricas\nWHERE $__timeFilter(capturado_em)\nORDER BY capturado_em"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#0ca30c", "value": null }, { "color": "#fab219", "value": 2 }, { "color": "#d03b3b", "value": 4 } ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
